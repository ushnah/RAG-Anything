QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
QWEN_API_KEY=local

# Optional: use local Qwen tokenizer, avoiding the default tiktoken download
RAG_TOKENIZER_MODEL=models/qwen2.5-vl-3b
# BGE_MODEL=BAAI/bge-m3

# Bound generation, including LightRAG graph extraction
QWEN_MAX_TOKENS=1536

